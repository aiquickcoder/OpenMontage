# /opt/openmontage/.env on the server (chmod 600, owner factory). Fill the empty values.

# --- Claude Code (headless) ---
CLAUDE_CODE_OAUTH_TOKEN=            # from `claude setup-token` on your machine (subscription)
FACTORY_CLAUDE_PROXY=http://127.0.0.1:10809   # xray: Anthropic is blocked from RU
FACTORY_CLAUDE_MAX_TURNS=400
FACTORY_RUN_TIMEOUT_S=10800

# --- Telegram (owner approvals) ---
TG_TOKEN=                           # @BotFather
TG_CHAT=                            # your chat id (send /start to @userinfobot)
TG_PROXY=socks5h://127.0.0.1:10809

# --- Releases for the phone farm ---
FACTORY_DATA_DIR=/srv/factory
FACTORY_RELEASES_DIR=/srv/factory/releases
FACTORY_RELEASE_BASE_URL=https://studio.luvael.ru/releases
RELEASE_TOKEN=                      # generated by install.sh

# --- Google Flow ---
FLOW_DRIVER=agent
FLOW_BRIDGE=1
FLOW_PROFILE=ultra
FLOW_PROFILE_DIR=/home/factory/flow-profile
FLOW_PLAN=free                      # thaddeu has no paid plan (50 credits); set ultra on a real Ultra account
FLOW_CREDIT_BUDGET_PER_PROJECT=40
FLOW_MIN_INTERVAL_SEC=60
FLOW_STATE_DIR=/srv/factory/flow-state
DISPLAY=:99
