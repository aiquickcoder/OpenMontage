[Unit]
Description=ЗАСНЯЛИ: collector (Telegram updates + catch-up, feeds, media downloads)
After=network-online.target

[Service]
Slice=zasnyali.slice
User=factory
WorkingDirectory=/opt/openmontage
EnvironmentFile=/opt/openmontage/.env

Environment=HOME=/home/factory PYTHONPATH=/opt/openmontage PYTHONUNBUFFERED=1 PATH=/opt/openmontage/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/openmontage/.venv/bin/python -m addons.channels.collect
Restart=always
RestartSec=20
MemoryMax=700M
Nice=5

[Install]
WantedBy=multi-user.target
