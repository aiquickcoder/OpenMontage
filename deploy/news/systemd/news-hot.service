[Unit]
Description=A film of a hot story from the take-off watch, on lane 2 (addons/news/watch.py run-queue → morning.py)
After=network-online.target docker.service

[Service]
Type=oneshot
User=factory
Group=factory
WorkingDirectory=/opt/openmontage
EnvironmentFile=/opt/openmontage/.env
EnvironmentFile=/opt/watermark-cleaner/deploy/.env
EnvironmentFile=-/etc/codex-gateway.env
Environment=HOME=/home/factory DISPLAY=:99 PYTHONUNBUFFERED=1 PATH=/opt/node22/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/openmontage/.venv/bin/python addons/news/watch.py run-queue
TimeoutStartSec=6h
